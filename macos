#!/usr/bin/env bash
# =============================================================================
# macos: the macOS settings this Mac holds, to be applied to a new one
# =============================================================================
#
#   ./macos --check    compare each setting with what the Mac holds now. Reads
#                      only: nothing is changed, and no password is asked for.
#   ./macos --apply    write every setting, then restart the Dock and the Finder.
#
# Every setting below is written with `defaults`, to the user's own preferences,
# so nothing here needs sudo.
#
# How this list was made (26 November 2026, macOS 26.7): the script kept here
# before was the public one at https://mths.be/macos, written for much older
# versions of macOS. Each of its 215 settings was read back from this Mac. The
# Mac held a value for 36 of them; the other 179 were unset here, belonged to
# applications that are not installed (Transmission, Twitter, Opera, SizeUp),
# or to parts of macOS that no longer exist (Dashboard, the sleep image, local
# Time Machine snapshots). Of the 36, 33 are kept, each with the Mac's own
# value; the three left out are the language, the region and which panes of a
# Get Info window are open. The built-in trackpad's three settings are added
# beside the Bluetooth trackpad's, which makes the 36 below. Time zone and
# power settings are left to macOS's own set-up.
#
# To add a setting: change it in System Settings, find the key with
# `defaults read <domain>`, add a line below, and run `./macos --check`: it must
# report no difference on the Mac the value was read from.

mode="${1:-}"
if [[ "$mode" != "--check" && "$mode" != "--apply" ]] || [[ $# -ne 1 ]]; then
    echo "macos: expected exactly one of --check or --apply, got: ${*:-nothing}" >&2
    echo "  ./macos --check    compare the settings with this Mac; changes nothing" >&2
    echo "  ./macos --apply    write the settings" >&2
    exit 2
fi

settings=0
differences=0

# setting [-currentHost] DOMAIN KEY TYPE VALUE
#   --apply: write the value. --check: say so if the Mac holds another, or none.
#   TYPE is -bool, -int, -float or -string, as `defaults write` takes them.
setting() {
    local host=""
    if [[ "$1" == "-currentHost" ]]; then
        host="-currentHost"
        shift
    fi
    local domain="$1" key="$2" type="$3" value="$4" want held
    settings=$((settings + 1))

    if [[ "$mode" == "--apply" ]]; then
        # $host is unquoted on purpose: empty, it must vanish and not be an argument
        if ! defaults $host write "$domain" "$key" "$type" "$value"; then
            echo "macos: could not write $domain $key $type $value" >&2
            exit 1
        fi
        return
    fi

    # `defaults read` prints a boolean as 1 or 0
    want="$value"
    if [[ "$type" == "-bool" ]]; then
        if [[ "$value" == "true" ]]; then want=1; else want=0; fi
    fi
    held="$(defaults $host read "$domain" "$key" 2>/dev/null)" || held="(not set)"
    if [[ "$held" != "$want" ]]; then
        echo "differs: $domain $key is $held here; this script sets $want"
        differences=$((differences + 1))
    fi
}

if [[ "$mode" == "--apply" ]]; then
    # An open System Settings window would write its own values back over these
    osascript -e 'tell application "System Settings" to quit'
fi

# =============================================================================
# Typing
# =============================================================================

# Capitalise the first word of a sentence, and turn a double space into a full stop
setting NSGlobalDomain NSAutomaticCapitalizationEnabled -bool true
setting NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool true

# =============================================================================
# Trackpad
# =============================================================================

# Tap to click, on the built-in trackpad, on a Bluetooth one, and at the login screen
setting com.apple.AppleMultitouchTrackpad Clicking -bool true
setting com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
setting -currentHost NSGlobalDomain com.apple.mouse.tapBehavior -int 1

# Secondary click with two fingers, not by clicking in a corner (0 is no corner)
setting com.apple.AppleMultitouchTrackpad TrackpadRightClick -bool true
setting com.apple.AppleMultitouchTrackpad TrackpadCornerSecondaryClick -int 0
setting com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadRightClick -bool true
setting com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadCornerSecondaryClick -int 0
setting -currentHost NSGlobalDomain com.apple.trackpad.enableSecondaryClick -bool true

# =============================================================================
# Finder
# =============================================================================

# A new window opens on the Desktop (PfDe is Finder's code for it)
setting com.apple.finder NewWindowTarget -string PfDe
setting com.apple.finder NewWindowTargetPath -string "file://${HOME}/Desktop/"

# On the desktop: external drives, servers and removable media, but not the internal drive
setting com.apple.finder ShowExternalHardDrivesOnDesktop -bool true
setting com.apple.finder ShowHardDrivesOnDesktop -bool false
setting com.apple.finder ShowMountedServersOnDesktop -bool true
setting com.apple.finder ShowRemovableMediaOnDesktop -bool true

# Show every file name extension, and do not warn when one is changed
setting NSGlobalDomain AppleShowAllExtensions -bool true
setting com.apple.finder FXEnableExtensionChangeWarning -bool false

# Show the status bar and the path bar
setting com.apple.finder ShowStatusBar -bool true
setting com.apple.finder ShowPathbar -bool true

# A folder springs open when something is dragged onto it, after half a second
setting NSGlobalDomain com.apple.springing.enabled -bool true
setting NSGlobalDomain com.apple.springing.delay -float 0.5

# Write no .DS_Store files on network or USB volumes
setting com.apple.desktopservices DSDontWriteNetworkStores -bool true
setting com.apple.desktopservices DSDontWriteUSBStores -bool true

# List view in every window (Nlsv; the others are icnv, clmv and glyv)
setting com.apple.finder FXPreferredViewStyle -string Nlsv

# Empty the Trash without asking
setting com.apple.finder WarnOnEmptyTrash -bool false

# =============================================================================
# Dock and hot corners
# =============================================================================

# Icons of 42 points; hide the Dock until the pointer reaches it
setting com.apple.dock tilesize -int 42
setting com.apple.dock autohide -bool true

# A dot under each open application; no row of recent applications
setting com.apple.dock show-process-indicators -bool true
setting com.apple.dock show-recents -bool false

# The bottom left corner of the screen does nothing (1 is no action, 0 is no modifier key)
setting com.apple.dock wvous-bl-corner -int 1
setting com.apple.dock wvous-bl-modifier -int 0

# =============================================================================
# Terminal and iTerm
# =============================================================================

# Terminal: Secure Keyboard Entry off
setting com.apple.terminal SecureKeyboardEntry -bool false

# iTerm: quit without asking
setting com.googlecode.iterm2 PromptOnQuit -bool false

# =============================================================================
# Activity Monitor
# =============================================================================

# Open the main window at launch, and list my processes (102; 100 is all processes)
setting com.apple.ActivityMonitor OpenMainWindow -bool true
setting com.apple.ActivityMonitor ShowCategory -int 102

# =============================================================================
# Report, or make the changes show
# =============================================================================

if [[ "$mode" == "--check" ]]; then
    echo "$settings settings compared: $differences differ from this script."
    [[ $differences -eq 0 ]]
    exit
fi

# The Dock and the Finder read their settings when they start; cfprefsd holds
# the cache the new values must come from. Each is restarted by macOS at once.
for app in cfprefsd Dock Finder SystemUIServer; do
    killall "$app" > /dev/null 2>&1
done
echo "$settings settings written. Terminal, iTerm and Activity Monitor use theirs when next opened;"
echo "the trackpad settings need a log out."
