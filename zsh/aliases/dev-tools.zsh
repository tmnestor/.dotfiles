# =============================================================================
# Development Tool Aliases (Lazy Loaded)
# =============================================================================

# UV (Python Package Manager) Aliases
alias uvi='uv add'
alias uvr='uv remove'
alias uvs='uv sync'
alias uvl='uv lock'
alias uvt='uv tool'
alias uvti='uv tool install'
alias uvtu='uv tool upgrade'
alias uvtr='uv tool uninstall'
alias uvtl='uv tool list'
alias uvp='uv python'
alias uvpi='uv python install'
alias uvpl='uv python list'
alias uvx='uv run'
alias uvdev='uv add --dev'
alias uvinit='uv init'
alias uvbuild='uv build'
alias uvpub='uv publish'
alias uvcheck='uv pip check'
alias uvenv='uv venv'
alias uvact='source .venv/bin/activate'

# Ruff (Python Linter & Formatter) Aliases
alias rf='ruff'
alias rfc='ruff check'
alias rfcf='ruff check --fix'
alias rff='ruff format'
alias rfcw='ruff check --watch'
alias rfall='ruff check --fix && ruff format'
alias rfconfig='ruff check --show-settings'
alias rfrules='ruff linter'
alias rfignore='ruff check --add-noqa'
alias rfstats='ruff check --statistics'
alias rfselect='ruff check --select'
alias rfignore-rule='ruff check --ignore'

# Homebrew Aliases
alias br='brew'
alias bri='brew install'
alias bru='brew uninstall'
alias brs='brew search'
alias brinfo='brew info'
alias brup='brew update'
alias brupg='brew upgrade'
alias brupgp='brew upgrade'
alias brlist='brew list'
alias brleaves='brew leaves'
alias brout='brew outdated'
alias brclean='brew cleanup'
alias brprune='brew autoremove'
alias brdeps='brew deps'
alias bruses='brew uses'
alias brcheck='brew doctor'
alias brservice='brew services'
alias brstart='brew services start'
alias brstop='brew services stop'
alias brrestart='brew services restart'
alias brservices='brew services list'
alias brpin='brew pin'
alias brunpin='brew unpin'
alias brpinned='brew list --pinned'
alias brformula='brew formulae'
alias brcask='brew install --cask'
alias brcasks='brew list --cask'
alias brfull='brew update && brew upgrade && brew cleanup && brew doctor'

# Conda/Mamba convenience aliases
alias mamba-create='mamba env create -f environment.yml'
alias mamba-update='mamba env update -f environment.yml --prune'
alias mamba-export='mamba env export > environment.yml'
alias conda-activate='source /opt/homebrew/Caskroom/miniforge/base/etc/profile.d/conda.sh && conda activate'
alias mamba-install='mamba install -c conda-forge'
